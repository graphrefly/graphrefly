{
  "name": "@graphrefly/authority",
  "private": true,
  "type": "module",
  "scripts": {
    "dashboard": "node dashboard/build.mjs",
    "dashboard:check": "node dashboard/build.mjs --check",
    "website:build": "node website/scripts/build.mjs",
    "docs:public:check": "node website/scripts/check-public.mjs",
    "docs:public:smoke": "npm run docs:public:check && node website/scripts/smoke-public.mjs",
    "docs:public:smoke:browser": "npm run docs:public:check && node website/scripts/smoke-public.mjs --require-playwright"
  }
}
