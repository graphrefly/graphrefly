{
  "name": "@graphrefly/authority",
  "private": true,
  "type": "module",
  "scripts": {
    "authority:check": "node authority/check.mjs",
    "authority:check:workspace": "node authority/check.mjs --workspace",
    "work:check": "node authority/work-check.mjs",
    "work:check:workspace": "node authority/work-check.mjs --workspace",
    "test:authority": "node --test authority/*.test.mjs",
    "test:reference": "node --test reference/kernel/kernel.test.mjs reference/kernel/replay.test.mjs reference/modules/pause.test.mjs reference/modules/pause.replay.test.mjs reference/modules/demand.test.mjs reference/modules/observe.test.mjs reference/flagship/flagship.test.mjs reference/flagship/mutants.test.mjs reference/operation-tree/spec.test.mjs reference/operation-tree/mutants.test.mjs",
    "dashboard": "node dashboard/build.mjs",
    "dashboard:workspace": "node dashboard/build.mjs --workspace",
    "dashboard:check": "node dashboard/build.mjs --check",
    "dashboard:check:workspace": "node dashboard/build.mjs --workspace --check",
    "website:build": "node website/scripts/build.mjs",
    "docs:public:check": "node website/scripts/check-public.mjs",
    "docs:public:smoke": "npm run docs:public:check && node website/scripts/smoke-public.mjs",
    "docs:public:smoke:browser": "npm run docs:public:check && node website/scripts/smoke-public.mjs --require-playwright"
  }
}
